# Editor defaults matching the formatters (.clang-format, .cmake-format.yaml):
# 2-space indents, LF line endings, a final newline, no trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

[tools/ci/images/ubuntu-24.04/decklink-sdk-16.0/include/**]
# The DeckLink SDK's files, kept as shipped (that directory's README.md).
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset
