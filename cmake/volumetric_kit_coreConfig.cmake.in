@PACKAGE_INIT@

# The base tier has no public dependencies. The vulkan tier, when this package
# was built with it, links Vulkan::Vulkan PUBLIC, so the imported target must
# exist for consumers -- from headers no older than the tier supports, refused
# here where FindVulkan reports a version (CMake 3.23 and newer), and otherwise
# by vulkan.hpp as it compiles.
include(CMakeFindDependencyMacro)
if(@VKC_WITH_VULKAN@)
  find_dependency(Vulkan @VKC_VULKAN_MIN_VERSION@)
  # vkc_compile_shaders / vkc_embed_shaders, as a fetching project gets them.
  include("${CMAKE_CURRENT_LIST_DIR}/vkc_shaders.cmake")
endif()
# The camera tier has no public dependency: nlohmann/json stays private.
#
# TODO: as the sensor tier lands, re-find its public dependencies here.

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_coreTargets.cmake")

check_required_components(volumetric_kit_core)
