#version 450

// The compute smoke shader: write each element's invocation index. The least
// kernel that proves a pipeline builds, binds a storage buffer and a push
// constant, dispatches through the platform's driver (MoltenVK on Apple), and
// hands back a result the host can check.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) writeonly buffer Output { uint values[]; };

layout(push_constant) uniform Push { uint count; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < count) {
    values[i] = i;
  }
}
