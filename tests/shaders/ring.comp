#version 450

// The HostRing test shader: dst[i] = src[i] + delta for the first `count`
// words, skipping every word whose index is a multiple of `skip` when `skip`
// is not 0, so a test sees what an output holds where no kernel writes.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint dst[]; };

layout(push_constant) uniform Push {
  uint count;
  uint delta;
  uint skip;
};

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < count && (skip == 0 || i % skip != 0)) {
    dst[i] = src[i] + delta;
  }
}
