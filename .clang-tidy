# clang-tidy: static analysis for first-party C++. Run it with
# -DVKC_CLANG_TIDY=ON, which lints every first-party target as it compiles
# (see CONTRIBUTING.md); CI's clang-tidy job does the same. Pinned to the
# clang-tidy release that matches the pinned clang-format.
#
# Broad families on, minus checks that conflict with the house style (Google
# style allows unbraced single-statement bodies; the family uses #pragma once;
# version numbers are macros so the preprocessor can test them) or that only
# add noise here.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  google-explicit-constructor,
  google-readability-casting,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix
WarningsAsErrors: '*'
# Headers are linted where a first-party file includes them; never third-party
# ones (googletest).
HeaderFilterRegex: '.*/include/volumetric_kit/core/.*'
SystemHeaders: false
# clang-tidy 22 parses as Clang 22, which reports __COUNTER__ -- VKC_ASSIGN's
# unique names -- as a C2y extension under -Wpedantic. The compilers CI builds
# with are older and do not. clang-tidy reports it only where no
# clang-analyzer-* check runs, so it surfaced when the test files dropped the
# analyzer (tests/.clang-tidy).
#
# TODO: a Clang 22 build with -Wpedantic and -Werror fails the same way, in the
# core and in any sibling that expands VKC_ASSIGN (recon and gfx build with
# -Wpedantic). Fix VKC_ASSIGN before CI's compilers reach Clang 22, then drop
# this.
ExtraArgs:
  - -Wno-c2y-extensions
CheckOptions:
  # First-party code reaches Vulkan only through
  # volumetric_kit/core/vulkan/vulkan.hpp (the vulkan-include-umbrella hook
  # enforces it), so include-cleaner must not ask for Vulkan's own headers. The
  # macOS SDK declares POSIX types and constants (mode_t, ssize_t, S_IRUSR,
  # O_RDONLY, SIGXFSZ) in headers of its own, which Linux lacks; the code
  # includes the POSIX headers that declare them, <sys/types.h> with "IWYU
  # pragma: keep", since on macOS it declares none of them itself. glibc
  # declares POSIX's additions to C headers there (mkdtemp in <stdlib.h>,
  # SIGPIPE in <signal.h>, strnlen in <string.h>), but C++ includes <cstdlib>,
  # <csignal> and <cstring> (modernize-deprecated-headers), which
  # include-cleaner does not credit. The same for the net tier's sockets: the
  # macOS SDK defines htons and ntohl in <sys/_endian.h> and FIONREAD in
  # <sys/filio.h>, and glibc takes SOL_SOCKET, the SO_ options and FIONREAD
  # from the kernel's <asm-generic/...> headers; the code includes
  # <arpa/inet.h>, <netinet/in.h>, <sys/socket.h> and <sys/ioctl.h>.
  # include-cleaner's map of the standard library lacks the chrono literals
  # (2s, 20ms), so it would ask for the header that defines them, libstdc++'s
  # <bits/chrono.h> or libc++'s <__chrono/duration.h>, rather than <chrono>.
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'vulkan/.*;vk_video/.*;sys/_types/.*;sys/fcntl\.h;signal\.h;stdlib\.h;string\.h;sys/_endian\.h;sys/filio\.h;asm-generic/.*;bits/chrono\.h;__chrono/duration\.h'
